<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ECOLENS — admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <!-- Quill editor -->
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <style>
        /* ── reset & base ── */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --bg: #f5f5f7;
            --bg-card: #ffffff;
            --border: #d0d0d8;
            --border-strong: #b0b0b8;
            --text: #111116;
            --text-secondary: #3a3a44;
            --text-tertiary: #7a7a88;
            --accent: #6c3ce0;
            --accent-light: #8b6cf0;
            --radius: 14px;
            --radius-sm: 8px;
            --shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
            --transition: 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        }

        body {
            background: var(--bg);
            color: var(--text);
            font-family: 'Inter', -apple-system, sans-serif;
            padding: 32px 24px 60px;
            min-height: 100vh;
        }

        .container {
            max-width: 900px;
            margin: 0 auto;
        }

        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 20px;
            border-bottom: 1px solid var(--border);
            margin-bottom: 32px;
            flex-wrap: wrap;
            gap: 12px;
        }

        .logo {
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 700;
            font-size: 28px;
            letter-spacing: -0.03em;
            color: var(--text);
        }
        .logo .dot {
            color: var(--accent);
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 16px;
            font-size: 14px;
            color: var(--text-secondary);
        }
        .user-info button {
            background: none;
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 6px 14px;
            font-size: 13px;
            cursor: pointer;
            color: var(--text-secondary);
            transition: all var(--transition);
        }
        .user-info button:hover {
            background: var(--bg-card);
            border-color: var(--border-strong);
        }

        .panel {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 28px 32px;
            margin-bottom: 28px;
            box-shadow: var(--shadow);
        }

        .panel h2 {
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 600;
            font-size: 20px;
            margin-bottom: 22px;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .panel h2 .pill {
            font-family: 'JetBrains Mono', monospace;
            font-size: 11px;
            font-weight: 500;
            text-transform: uppercase;
            background: var(--accent);
            color: #fff;
            padding: 2px 14px;
            border-radius: 999px;
            opacity: 0.8;
        }

        .form-group {
            margin-bottom: 18px;
        }
        .form-group label {
            display: block;
            font-family: 'JetBrains Mono', monospace;
            font-size: 11px;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: var(--text-secondary);
            margin-bottom: 5px;
        }
        .form-group input,
        .form-group textarea {
            width: 100%;
            padding: 10px 14px;
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            font-family: 'Inter', sans-serif;
            font-size: 14px;
            background: #fff;
            transition: border-color var(--transition);
            outline: none;
        }
        .form-group input:focus,
        .form-group textarea:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(108, 60, 224, 0.08);
        }
        .form-group textarea {
            min-height: 80px;
            resize: vertical;
        }

        .row2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 18px;
        }
        @media (max-width: 600px) {
            .row2 {
                grid-template-columns: 1fr;
            }
        }

        /* Quill editor */
        #editor-container {
            min-height: 260px;
            background: #fff;
            border-radius: var(--radius-sm);
        }
        .ql-toolbar.ql-snow {
            border-radius: var(--radius-sm) var(--radius-sm) 0 0;
            border-color: var(--border);
            background: #fafafa;
        }
        .ql-container.ql-snow {
            border-radius: 0 0 var(--radius-sm) var(--radius-sm);
            border-color: var(--border);
            font-size: 15px;
            font-family: 'Inter', sans-serif;
        }
        .ql-editor {
            min-height: 200px;
        }

        .form-actions {
            display: flex;
            gap: 12px;
            margin-top: 18px;
            flex-wrap: wrap;
        }
        .btn {
            padding: 10px 24px;
            border-radius: var(--radius-sm);
            font-family: 'Inter', sans-serif;
            font-weight: 600;
            font-size: 14px;
            border: none;
            cursor: pointer;
            transition: all var(--transition);
        }
        .btn:active {
            transform: scale(0.97);
        }
        .btn-primary {
            background: var(--accent);
            color: #fff;
        }
        .btn-primary:hover {
            background: var(--accent-light);
            box-shadow: 0 4px 12px rgba(108, 60, 224, 0.25);
        }
        .btn-secondary {
            background: #e8e8f0;
            color: var(--text-secondary);
        }
        .btn-secondary:hover {
            background: #d8d8e0;
        }
        .btn-danger {
            background: #fce4e4;
            color: #c0392b;
        }
        .btn-danger:hover {
            background: #fcd0d0;
        }
        .btn-small {
            padding: 6px 14px;
            font-size: 12px;
        }

        .error-msg {
            color: #c0392b;
            font-family: 'JetBrains Mono', monospace;
            font-size: 13px;
            margin-top: 8px;
        }
        .status-msg {
            color: #27ae60;
            font-family: 'JetBrains Mono', monospace;
            font-size: 13px;
            margin-top: 8px;
        }

        /* post list */
        .post-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 14px 0;
            border-bottom: 1px solid var(--border);
            gap: 12px;
        }
        .post-item:last-child {
            border-bottom: none;
        }
        .post-item .info {
            flex: 1;
            min-width: 0;
        }
        .post-item .info .title {
            font-weight: 600;
            font-size: 15px;
        }
        .post-item .info .meta {
            font-family: 'JetBrains Mono', monospace;
            font-size: 12px;
            color: var(--text-tertiary);
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }
        .post-item .actions {
            display: flex;
            gap: 6px;
            flex-shrink: 0;
        }

        .empty-state {
            padding: 30px 0;
            text-align: center;
            color: var(--text-tertiary);
        }

        .loading {
            color: var(--text-tertiary);
            padding: 20px 0;
            text-align: center;
        }

        .footer {
            margin-top: 40px;
            padding-top: 20px;
            border-top: 1px solid var(--border);
            font-family: 'JetBrains Mono', monospace;
            font-size: 12px;
            color: var(--text-tertiary);
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
        }
        .footer .heart {
            color: #d63384;
        }
        .footer .dev-credit strong {
            color: var(--accent);
        }
    </style>
</head>
<body>

    <div class="container" id="app">
        <!-- will be rendered by JS -->
    </div>

    <footer class="footer">
        <span>© <span id="year"></span> ECOLENS</span>
        <span class="dev-credit">Developed by <strong>Anoof</strong> <span class="heart">♥</span></span>
    </footer>

    <script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>
    <script type="module">
        import { createClient } from 'https://esm.sh/@supabase/supabase-js@2';

        const SUPABASE_URL = 'https://ojlmwlqrkbctlpexrufs.supabase.co';
        const SUPABASE_KEY = 'sb_publishable_2aMsITRDeO8MfFHiWIkNzQ_JENBP08R';
        const supabase = createClient(SUPABASE_URL, SUPABASE_KEY);

        document.getElementById('year').textContent = new Date().getFullYear();

        const app = document.getElementById('app');

        function escapeHtml(str) {
            return String(str ?? '').replace(/[&<>"']/g, m => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;',
                "'": '&#39;' }[m]));
        }

        function slugify(str) {
            return String(str || '')
                .toLowerCase()
                .trim()
                .replace(/[^a-z0-9\s-]/g, '')
                .replace(/\s+/g, '-')
                .replace(/-+/g, '-')
                .replace(/^-|-$/g, '');
        }

        // ─── LOGIN ──────────────────────────────────────────
        function renderLogin() {
            app.innerHTML = `
            <div style="max-width:400px;margin:60px auto;background:var(--bg-card);padding:36px;border-radius:var(--radius);border:1px solid var(--border);box-shadow:var(--shadow);">
              <h1 style="font-family:'Space Grotesk',sans-serif;font-size:26px;">Sign in</h1>
              <p style="color:var(--text-secondary);margin-bottom:24px;">Authenticate to manage posts.</p>
              <form id="login-form">
                <div class="form-group">
                  <label for="email">Email</label>
                  <input id="email" type="email" placeholder="you@example.com" required />
                </div>
                <div class="form-group">
                  <label for="password">Password</label>
                  <input id="password" type="password" placeholder="••••••••" required />
                </div>
                <div class="error-msg" id="login-error"></div>
                <button type="submit" class="btn btn-primary" style="width:100%;">Sign in</button>
              </form>
            </div>
          `;

            const form = document.getElementById('login-form');
            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                const err = document.getElementById('login-error');
                err.textContent = '';
                const btn = form.querySelector('button');
                btn.disabled = true;
                btn.textContent = 'Signing in…';

                const email = document.getElementById('email').value.trim();
                const password = document.getElementById('password').value;
                const { error } = await supabase.auth.signInWithPassword({ email, password });
                if (error) {
                    err.textContent = error.message;
                    btn.disabled = false;
                    btn.textContent = 'Sign in';
                    return;
                }
                renderDashboard();
            });
        }

        // ─── DASHBOARD ──────────────────────────────────────
        async function renderDashboard() {
            const { data: { session } } = await supabase.auth.getSession();
            if (!session) { renderLogin(); return; }

            // Build the admin UI with Quill editor
            app.innerHTML = `
            <div class="topbar">
              <span class="logo">ECOLENS<span class="dot">.</span></span>
              <div class="user-info">
                ${escapeHtml(session.user.email)}
                <button id="logout-btn">Sign out</button>
              </div>
            </div>

            <div class="panel">
              <h2 id="editor-heading">New post <span class="pill">draft</span></h2>
              <form id="post-form">
                <input type="hidden" id="edit-id" value="" />

                <div class="form-group">
                  <label for="f-title">Title</label>
                  <input id="f-title" placeholder="Write a headline" required />
                </div>

                <div class="form-group">
                  <label for="f-slug">Slug (URL)</label>
                  <input id="f-slug" placeholder="auto-generated from title" />
                  <div style="font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--accent);margin-top:4px;" id="slug-preview">index.html?post=…</div>
                </div>

                <div class="row2">
                  <div class="form-group">
                    <label for="f-tag">Tag</label>
                    <input id="f-tag" placeholder="e.g. inflation" />
                  </div>
                  <div class="form-group">
                    <label for="f-emoji">Emoji</label>
                    <input id="f-emoji" placeholder="📰" maxlength="4" />
                  </div>
                </div>

                <div class="form-group">
                  <label for="f-excerpt">One‑line take (shows on feed)</label>
                  <input id="f-excerpt" placeholder="The tl;dr" maxlength="160" />
                </div>

                <div class="form-group">
                  <label for="f-readtime">Read time (minutes)</label>
                  <input id="f-readtime" type="number" min="1" max="60" value="5" style="max-width:120px;" />
                </div>

                <div class="form-group">
                  <label>Body (HTML / rich text)</label>
                  <div id="editor-container"></div>
                </div>

                <div class="error-msg" id="form-error"></div>
                <div class="status-msg" id="form-status"></div>

                <div class="form-actions">
                  <button type="submit" class="btn btn-primary" id="save-btn">Publish</button>
                  <button type="button" class="btn btn-secondary" id="cancel-edit-btn" style="display:none;">Cancel edit</button>
                </div>
              </form>
            </div>

            <div class="panel">
              <h2>Published posts</h2>
              <div id="post-list"><div class="loading">loading…</div></div>
            </div>
          `;

            // ── Quill editor ──
            const quill = new Quill('#editor-container', {
                theme: 'snow',
                placeholder: 'Write your post here…',
                modules: {
                    toolbar: [
                        [{ 'header': [1, 2, 3, false] }],
                        ['bold', 'italic', 'underline', 'strike'],
                        [{ 'list': 'ordered' }, { 'list': 'bullet' }],
                        ['link', 'blockquote', 'code-block'],
                        ['clean']
                    ]
                }
            });

            // ── Logout ──
            document.getElementById('logout-btn').addEventListener('click', async () => {
                await supabase.auth.signOut();
                renderLogin();
            });

            // ── Slug logic ──
            const slugInput = document.getElementById('f-slug');
            const titleInput = document.getElementById('f-title');
            const slugPreview = document.getElementById('slug-preview');
            let slugManuallyEdited = false;

            function updateSlugPreview() {
                const val = slugInput.value || slugify(titleInput.value) || '…';
                slugPreview.textContent = 'index.html?post=' + val;
            }
            titleInput.addEventListener('input', () => {
                if (!slugManuallyEdited) slugInput.value = slugify(titleInput.value);
                updateSlugPreview();
            });
            slugInput.addEventListener('input', () => {
                slugManuallyEdited = true;
                slugInput.value = slugify(slugInput.value);
                updateSlugPreview();
            });
            updateSlugPreview();

            // ── Cancel edit ──
            document.getElementById('cancel-edit-btn').addEventListener('click', resetForm);

            // ── Submit ──
            document.getElementById('post-form').addEventListener('submit', async (e) => {
                e.preventDefault();
                const errEl = document.getElementById('form-error');
                const statusEl = document.getElementById('form-status');
                const saveBtn = document.getElementById('save-btn');
                errEl.textContent = '';
                statusEl.textContent = '';

                const editId = document.getElementById('edit-id').value;
                const title = titleInput.value.trim();
                const slug = slugify(slugInput.value || titleInput.value);

                if (!title || !slug) {
                    errEl.textContent = 'Title and slug are required.';
                    return;
                }

                // Get HTML content from Quill
                const content = quill.root.innerHTML;

                const payload = {
                    title,
                    slug,
                    tag: document.getElementById('f-tag').value.trim() || 'econ',
                    image_emoji: document.getElementById('f-emoji').value.trim() || '📰',
                    excerpt: document.getElementById('f-excerpt').value.trim(),
                    read_time: parseInt(document.getElementById('f-readtime').value, 10) || 5,
                    content: content,
                };

                saveBtn.disabled = true;
                saveBtn.textContent = editId ? 'Saving…' : 'Publishing…';

                let result;
                if (editId) {
                    result = await supabase.from('posts').update(payload).eq('id', editId).select();
                } else {
                    result = await supabase.from('posts').insert(payload).select();
                }

                saveBtn.disabled = false;
                saveBtn.textContent = 'Publish';

                if (result.error) {
                    if (result.error.code === '23505') {
                        errEl.textContent = 'That slug is already taken — pick a different one.';
                    } else {
                        errEl.textContent = result.error.message;
                    }
                    return;
                }

                statusEl.textContent = editId ? '✓ Saved.' : '✓ Published.';
                setTimeout(() => { statusEl.textContent = ''; }, 4000);
                resetForm();
                loadPostList();
            });

            function resetForm() {
                document.getElementById('post-form').reset();
                document.getElementById('edit-id').value = '';
                document.getElementById('f-readtime').value = 5;
                document.getElementById('editor-heading').innerHTML = 'New post <span class="pill">draft</span>';
                document.getElementById('cancel-edit-btn').style.display = 'none';
                slugManuallyEdited = false;
                updateSlugPreview();
                quill.root.innerHTML = '';
                document.getElementById('form-error').textContent = '';
                document.getElementById('form-status').textContent = '';
            }

            // ── Load post list ──
            async function loadPostList() {
                const listEl = document.getElementById('post-list');
                const { data, error } = await supabase
                    .from('posts')
                    .select('id, title, slug, tag, views, created_at')
                    .order('created_at', { ascending: false });

                if (error) {
                    listEl.innerHTML = `<div class="empty-state">couldn't load posts: ${escapeHtml(error.message)}</div>`;
                    return;
                }
                if (!data || data.length === 0) {
                    listEl.innerHTML = `<div class="empty-state">No posts yet. Write your first one above.</div>`;
                    return;
                }

                listEl.innerHTML = data.map(p => `
                <div class="post-item" data-id="${p.id}">
                  <div class="info">
                    <div class="title">${escapeHtml(p.title)}</div>
                    <div class="meta">/${escapeHtml(p.slug)} · ${escapeHtml(p.tag || 'econ')} · ${p.views || 0} views</div>
                  </div>
                  <div class="actions">
                    <button class="btn btn-secondary btn-small" data-action="edit" data-id="${p.id}">Edit</button>
                    <button class="btn btn-danger btn-small" data-action="delete" data-id="${p.id}" data-title="${escapeHtml(p.title)}">Delete</button>
                  </div>
                </div>
              `).join('');

                // Edit
                listEl.querySelectorAll('[data-action="edit"]').forEach(btn => {
                    btn.addEventListener('click', async () => {
                        const { data: post, error } = await supabase.from('posts').select('*').eq('id', btn
                            .dataset.id).single();
                        if (error || !post) return;
                        document.getElementById('edit-id').value = post.id;
                        document.getElementById('f-title').value = post.title || '';
                        document.getElementById('f-slug').value = post.slug || '';
                        document.getElementById('f-tag').value = post.tag || '';
                        document.getElementById('f-emoji').value = post.image_emoji || '';
                        document.getElementById('f-excerpt').value = post.excerpt || '';
                        document.getElementById('f-readtime').value = post.read_time || 5;
                        // Set Quill content
                        quill.root.innerHTML = post.content || '';
                        slugManuallyEdited = true;
                        updateSlugPreview();
                        document.getElementById('editor-heading').innerHTML =
                            'Editing <span class="pill">' + escapeHtml(post.slug) + '</span>';
                        document.getElementById('cancel-edit-btn').style.display = 'inline-block';
                        document.querySelector('.panel').scrollIntoView({ behavior: 'smooth' });
                    });
                });

                // Delete
                listEl.querySelectorAll('[data-action="delete"]').forEach(btn => {
                    btn.addEventListener('click', async () => {
                        if (!confirm(`Delete "${btn.dataset.title}"? This can't be undone.`)) return;
                        const { error } = await supabase.from('posts').delete().eq('id', btn.dataset.id);
                        if (error) { alert('Delete failed: ' + error.message); return; }
                        loadPostList();
                    });
                });
            }

            loadPostList();
        }

        // ─── BOOT ──────────────────────────────────────────
        (async function init() {
            const { data: { session } } = await supabase.auth.getSession();
            if (session) renderDashboard();
            else renderLogin();
        })();

        supabase.auth.onAuthStateChange((event) => {
            if (event === 'SIGNED_OUT') renderLogin();
        });
    </script>
</body>
</html>
